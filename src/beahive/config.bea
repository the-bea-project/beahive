// src/beahive/config.bea

import dot_env
import beahive/runtime/runtime
import gleam/erlang/atom
import envoy

pub type Config {
  Config(
    app_version: String,
    host: String,
    port: Int,
    db_path: String,
    ip_rate_limit_attempts: Int,
    ip_rate_limit_window_secs: Int,
    ip_rate_ttl_secs: Int,
  )
}

def do_load() -> Result(Config, Nil) {
  // Loads the .env file at project root
  dot_env.load_default()
  
  // Uses FFI to get the app version
  app_version = runtime.app_version(atom.create("beahive"))

  Config(
    app_version,
    envoy.get("HOST")?,
    envoy.get("PORT")? |> int.parse()?,
    envoy.get("DB_PATH")?,
    envoy.get("IP_RATE_LIMIT_ATTEMPTS")? |> int.parse()?,
    envoy.get("IP_RATE_LIMIT_WINDOW_SECS")? |> int.parse()?,
    envoy.get("IP_RATE_TTL_SECS")? |> int.parse()?,
  )
  |> Ok
}

pub def load() -> Config {
  case do_load() {
    Ok(c) -> c
    _ -> panic as "Missing config!"
  }
}