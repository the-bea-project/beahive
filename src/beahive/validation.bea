//// Checks on request bodies before they reach the application logic.

import beahive/errors
import beahive/types

def parse_permission(p: String) -> Result(types.Permissions, errors.ValidationError) {
  case p {
    "read" -> Ok(types.Read)
    "write" -> Ok(types.Write)
    "delete" -> Ok(types.Delete)
    _ -> Error(errors.InvalidPermission("unknown permission: #{p}"))
  }
}

/// Permission names (`"read"`, `"write"`, `"delete"`) as `Permissions`;
/// the first unknown name fails the whole list.
pub def parse_permissions(
  p: List(String),
) -> Result(List(types.Permissions), errors.ValidationError) {
  list.try_map(p, parse_permission)
}

/// Validates a registration: username and password lengths, and the
/// permission names, which come back parsed.
pub def reg_req(username: String, password: String, permissions: List(String)) {
  string.length(username) >= 3
    else Error(
      errors.InvalidUsername("username needs to have more than 2 characters"),
    )

  string.length(password) >= 12
    else Error(
      errors.PasswordTooShort("username needs to have more than 11 characters"),
    )

  parsed = parse_permissions(permissions)?
  Ok(parsed)
}
