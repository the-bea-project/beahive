//// The global router: rate limiting for every request, the root status
//// endpoint, and `/api/v1/…`, which each feature's router handles.

import gleam/http
import gleam/http/request.{type Request}
import gleam/http/response.{type Response}
import gleam/json
import gleam/time/duration
import gleam/time/timestamp

import ewe

import beahive/auth/router as auth_router
import beahive/client/router as client_router
import beahive/context.{type Context}
import beahive/middleware
import beahive/responses

def handle_root(ctx: Context) -> Response(ewe.Body) {
  uptime =
    timestamp.difference(ctx.boot_time, timestamp.system_time())
    |> duration.to_seconds
  data = json.object([
    ("app", json.string("beahive")),
    ("version", json.string(ctx.config.app_version)),
    ("uptime_seconds", json.float(uptime)),
  ])
  responses.send_resp_json(200, "App root hit!", data)
}

pub def handle_request(
  ctx: Context,
  req: Request(ewe.Connection),
) -> Response(ewe.Body) {
  // Rate limiting runs before routing, so it covers every path.
  middleware.allow(req, ctx)
    else responses.send_resp_json(429, "Global middleware 429!", json.null())

  case req.method, request.path_segments(req) {
    http.Get, [] -> handle_root(ctx)
    _, ["api", "v1" | rest] -> handle_v1(ctx, req, rest)
    _, _ -> responses.send_resp_json(404, "Global router 404!", json.null())
  }
}

/// `/api/v1/…`: each feature routes the rest of the path.
def handle_v1(
  ctx: Context,
  req: Request(ewe.Connection),
  path: List(String),
) -> Response(ewe.Body) {
  case path {
    ["auth" | rest] -> auth_router.handle_request(ctx, req, rest)
    ["client" | rest] -> client_router.handle_request(ctx, req, rest)
    _ -> responses.send_resp_json(404, "V1 router 404!", json.null())
  }
}
