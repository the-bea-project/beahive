//// What the API sends back: the JSON envelope every response uses, and the
//// public representations of stored data.

import gleam/http/response
import gleam/json.{type Json}

import ewe

import bea_json/encoder
import generated/sql/beahive_sql

/// A JSON response: `{"status": …, "message": …, "data": …}`, where
/// `status` repeats the HTTP status code.
pub def send_resp_json(status: Int, message: String, data: Json) {
  body_str =
    json.object([
      ("status", json.int(status)),
      ("message", json.string(message)),
      ("data", data),
    ])
    |> json.to_string()

  response.new(status)
  |> response.set_header("content-type", "application/json; charset=utf-8")
  |> response.set_body(ewe.Text(body_str))
}

/// A client as the API shows it: no password hash, permissions by name.
@derive(encoder)
pub type ClientListing {
  username: String,
  permissions: List(String),
  enabled: Bool,
}

@derive(encoder)
pub type ClientListResponse {
  clients: List(ClientListing)
}

/// A row of `list_clients.sql` as a `ClientListing`. Not used by
/// `GET /api/v1/client/list` yet, which doesn't return the clients.
pub def to_client_listing(row: beahive_sql.ListClientsRow) -> ClientListing {
  username = case row.username {
    Some(name) -> name
    None -> ""
  }

  // SQLite stores each permission as a 0/1 flag. Rebinding `permissions`
  // builds the list up; nothing is mutated.
  permissions = []

  permissions = if row.can_read == 1 {
    ["read" | permissions]
  } else {
    permissions
  }

  permissions = if row.can_write == 1 {
    ["write" | permissions]
  } else {
    permissions
  }

  permissions = if row.can_delete == 1 {
    ["delete" | permissions]
  } else {
    permissions
  }

  ClientListing(
    username:,
    permissions: list.reverse(permissions),
    enabled: row.enabled == 1,
  )
}
