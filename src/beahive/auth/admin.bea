//// Administrator login, against the credentials in the configuration.

import beahive/auth/jwt
import beahive/context
import beahive/types

/// A token for the administrator when the username and password match
/// `ADMIN_USERNAME` and `ADMIN_PASSWORD`.
pub def check(ctx: context.Context, username: String, password: String) {
  valid_username = username == ctx.config.admin_username
  valid_password = password == ctx.config.admin_password

  if valid_username and valid_password {
    admin = types.Authenticated(subject: "admin", role: types.Administrator)
    jwt.generate(admin, ctx.config.jwt_secret)
    |> Ok
  } else {
    Error(Nil)
  }
}
