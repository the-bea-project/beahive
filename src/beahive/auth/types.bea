// src/beahive/auth/types.bea

import bea_json/decoder

pub type Permissions {
  Read
  Write
  Delete
}

pub type Roles {
  Administrator
  Client(List(Permissions))
}

pub type Authenticated {
  Authenticated(subject: String, role: Roles)
}

@derive(decoder)
pub type AuthToken {
  AuthToken(
    sub: String,
    role: String
  )
}