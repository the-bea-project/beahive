//// Client login, against the clients stored in SQLite.

import argus
import sqlight

import beahive/auth/jwt
import beahive/client/manager
import beahive/context
import beahive/errors
import beahive/types

// SQLite's 0/1 permission flags as `Permissions`. Each rebinding of `acc`
// is a new list; nothing is mutated.
def parse_permissions(can_read: Int, can_write: Int, can_delete: Int) -> List(types.Permissions) {
  acc = []

  acc = if can_read == 1 {
    [types.Read | acc]
  } else {
    acc
  }

  acc = if can_write == 1 {
    [types.Write | acc]
  } else {
    acc
  }

  acc = if can_delete == 1 {
    [types.Delete | acc]
  } else {
    acc
  }

  acc
}

/// A token for the client when the password matches its stored hash and the
/// client is enabled. The token carries the username and the `client` role;
/// the permissions are read from the database but aren't in the token.
pub def check(ctx: context.Context, username: String, password: String) -> Result(String, errors.ClientError(argus.HashError, sqlight.Error)){
  // An unknown username or a database error returns from here.
  client_row = manager.get_client(ctx, username)?

  // The stored Argon2id hash embeds its salt and parameters, so Argus can
  // check the password against it directly.
  valid = argus.verify(client_row.password_hash, password)?
    else e -> Error(errors.HashingFailed(e))

  valid else Error(errors.InvalidPassword)
  client_row.enabled == 1 else Error(errors.ClientDisabled)

  permissions = parse_permissions(client_row.can_read, client_row.can_write, client_row.can_delete)

  client = types.Authenticated(subject: username, role: types.Client(permissions))

  jwt.generate(client, ctx.config.jwt_secret)
  |> Ok
}
