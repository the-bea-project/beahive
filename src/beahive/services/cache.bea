// src/beahive/services/cache.bea

import rasa/table

import gleam/order
import gleam/time/timestamp
import gleam/time/duration

pub type RateLimitEntry {
  RateLimitEntry(
    count: Int,
    last_hit_at: timestamp.Timestamp,
    expires_at: timestamp.Timestamp,
  )
}

pub type RateLimitCache = table.Table(String, RateLimitEntry)

pub def setup_rate_cache() {
  table.new()
  |> table.with_kind(table.Set)
  |> table.with_access(table.Public)
  |> table.build()
}

pub def get_rate_hits(cache: RateLimitCache, ip: String) {
  case table.lookup(cache, ip) {
    Ok(entry) -> {
      if timestamp.compare(
        timestamp.system_time(),
        entry.expires_at,
      ) == order.Lt {
        Some(entry)
      } else {
        _ = table.delete(cache, ip)
        None
      }
    }
    Error(Nil) -> None
  }
}

pub def set_rate_hits(
  cache: RateLimitCache,
  ip: String,
  last_hit_at: timestamp.Timestamp,
  count: Int,
  ttl_secs: Int,
) {
  expires_at = timestamp.add(
    timestamp.system_time(),
    duration.seconds(ttl_secs),
  )
  table.insert(cache, ip, RateLimitEntry(count:, last_hit_at:, expires_at:))
}
