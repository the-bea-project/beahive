// src/beahive_web/api/v1/router.bea

import ewe

import gleam/json
import gleam/http/request.{type Request}
import gleam/http/response.{type Response}

import beahive/context.{type Context}
import beahive_web/utils
import beahive_web/api/v1/auth/router as auth_router
import beahive_web/api/v1/client/router as client_router

pub def handle_request(
  ctx: Context,
  req: Request(ewe.Connection),
  path: List(String),
) -> Response(ewe.Body) {
  case path {
    ["auth" | rest] -> auth_router.handle_request(ctx, req, rest)
    ["client" | rest] -> client_router.handle_request(ctx, req, rest)
    _ -> utils.send_resp_json(404, "V1 router 404!", json.null())
  }
}
