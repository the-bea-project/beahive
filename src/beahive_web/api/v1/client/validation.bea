import beahive/auth/types
import beahive_web/api/v1/client/types as client_types

def parse_permission(
  p: String,
) -> Result(types.Permissions, client_types.ValidationError) {
  case p {
    "read" -> Ok(types.Read)
    "write" -> Ok(types.Write)
    "delete" -> Ok(types.Delete)
    _ -> Error(client_types.InvalidPermission("unknown permission: #{p}"))
  }
}

pub def parse_permissions(
  p: List(String),
) -> Result(List(types.Permissions), client_types.ValidationError) {
  list.try_map(p, parse_permission)
}

pub def reg_req(username: String, password: String, permissions: List(String)) {
  string.length(username) >= 3
    else Error(
      client_types.InvalidUsername(
        "username needs to have more than 2 characters",
      ),
    )

  string.length(password) >= 12
    else Error(
      client_types.InvalidPassword(
        "username needs to have more than 11 characters",
      ),
    )

  parsed = parse_permissions(permissions)?
  Ok(parsed)
}
