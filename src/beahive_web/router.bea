// src/beahive_web/router.bea

import gleam/http
import gleam/http/request
import gleam/http/response.{type Response}
import gleam/json
import gleam/time/duration
import gleam/time/timestamp

import ewe

import beahive/context.{type Context}
import beahive_web/api/v1/router as v1_router
import beahive_web/middleware as global_middleware
import beahive_web/utils

def handle_root(ctx: Context) -> Response(ewe.Body) {
  uptime =
    timestamp.difference(ctx.boot_time, timestamp.system_time())
    |> duration.to_seconds
  data = json.object([
    ("app", json.string("beahive")),
    ("version", json.string(ctx.config.app_version)),
    ("uptime_seconds", json.float(uptime)),
  ])
  utils.send_resp_json(200, "App root hit!", data)
}

pub def handle_request(
  ctx: Context,
  req: request.Request(ewe.Connection),
) -> Response(ewe.Body) {
  global_middleware.allow(req, ctx)
    else utils.send_resp_json(429, "Global middleware 429!", json.null())

  case req.method, request.path_segments(req) {
    http.Get, [] -> handle_root(ctx)
    _, ["api", "v1" | rest] -> v1_router.handle_request(ctx, req, rest)
    _, _ -> utils.send_resp_json(404, "Global router 404!", json.null())
  }
}
