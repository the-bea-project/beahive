//// Beahive's entry point: loads the configuration, opens the database and
//// serves HTTP with ewe.

import gleam/erlang/process

import ewe

import beahive/config
import beahive/context
import beahive/router

pub def main() {
  cfg = config.load()
  ctx = context.build(cfg)

  _ =
    ewe.new(handler: fn(req) { router.handle_request(ctx, req) })
    |> ewe.bind(to: cfg.host)
    |> ewe.listening(on: cfg.port)
    |> ewe.start

  process.sleep_forever()
}
